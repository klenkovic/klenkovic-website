---
interface Props { name: string; class?: string; }
const { name, class: className } = Astro.props;
---
<svg class={className} width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === 'spark' && <><path d="m12 2 3 7 7 3-7 3-3 7-3-7-7-3 7-3Z"/></>}
  {name === 'arrow' && <><path d="M5 12h14M12 5l7 7-7 7" /></>}
  {name === 'diagonal' && <><path d="M6 18 18 6M6 6h12v12" /></>}
  {name === 'down' && <><path d="M12 4v16m-6-6 6 6 6-6" /></>}
  {name === 'sun' && <><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.4 1.4m11.2 11.2L19 19M5 19l1.4-1.4M17.6 6.4 19 5"/></>}
  {name === 'moon' && <><path d="M20.7 13.1A9 9 0 0 1 10.9 3.3 9 9 0 1 0 20.7 13.1Z"/></>}
  {name === 'close' && <><path d="m6 6 12 12M6 18 18 6"/></>}
  {name === 'people' && <><circle cx="9" cy="8" r="3"/><path d="M3 21v-3a6 6 0 0 1 12 0v3M16 5a3 3 0 0 1 0 6m2 4a5 5 0 0 1 3 4v2"/></>}
  {name === 'architecture' && <><rect x="8" y="2" width="8" height="6" rx="1"/><rect x="2" y="16" width="8" height="6" rx="1"/><rect x="14" y="16" width="8" height="6" rx="1"/><path d="M12 8v4m-6 4v-4h12v4"/></>}
  {name === 'shield' && <><path d="m12 2 8 4v6c0 5-8 10-8 10S4 17 4 12V6l8-4Z"/><path d="m8 12 3 3 5-6"/></>}
  {name === 'globe' && <><circle cx="12" cy="12" r="9"/><ellipse cx="12" cy="12" rx="4" ry="9"/><path d="M3 12h18"/></>}
  {name === 'mail' && <><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 6 9 7 9-7"/></>}
</svg>
