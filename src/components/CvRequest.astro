---
import Icon from './Icon.astro';
import { site } from '../data/site';
let endpoint = '';
try {
  const url = new URL(site.formEndpoint, Astro.site);
  if (site.formEndpoint && !url.username && !url.password && !url.search && !url.hash && (url.protocol === 'https:' || (url.protocol === 'http:' && ['localhost', '127.0.0.1'].includes(url.hostname)))) endpoint = url.href;
} catch {}
const configured = !!endpoint && !!site.turnstileSiteKey;
const linkedIn = site.profiles.find(profile => profile.label === 'LinkedIn')!;
---
<dialog id="cv-dialog" aria-labelledby="cv-title" aria-describedby="cv-description">
  <div class="dialog-content">
    <button class="icon-button dialog-close" type="button" aria-label="Close CV request"><Icon name="close" /></button>
    <h2 id="cv-title">Request my CV</h2>
    <p id="cv-description">Tell me how to reach you and I’ll send you my CV personally. Feel free to share a role or a little context.</p>
    <form id="cv-form" action={configured ? endpoint : undefined} method="POST" data-configured={String(configured)}>
      <div class="form-row">
        <label>Your name<input name="name" autocomplete="name" required maxlength="100" /></label>
        <label>Your email<input name="email" type="email" autocomplete="email" required maxlength="200" /></label>
      </div>
      <label>Company (optional)<input name="company" autocomplete="organization" maxlength="150" /></label>
      <label>Message (optional)<textarea name="message" maxlength="2000" rows="3"></textarea></label>

      <label class="honeypot" aria-hidden="true">Leave empty<input name="_gotcha" tabindex="-1" autocomplete="off" /></label>
      {configured && <div class="captcha-container" data-turnstile-sitekey={site.turnstileSiteKey}></div>}
      <button type="submit" class="button button-primary" disabled={!configured}>Send request <Icon name="diagonal" /></button>
      <p id="form-status" class="form-status" role="status" aria-live="polite">{!configured ? 'The form is temporarily unavailable. Please contact me on LinkedIn.' : ''}</p>
      <p class="form-note">You can also <a href={linkedIn.url} target="_blank" rel="noopener noreferrer">message me on LinkedIn</a>.</p>
      <p class="form-note">Your details are used to respond to your request. <a href="/privacy/">Privacy policy</a></p>
      <noscript><p class="form-note">Enable JavaScript to complete the spam check.</p></noscript>
    </form>
  </div>
</dialog>
