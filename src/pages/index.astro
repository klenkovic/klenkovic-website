---
import '@fontsource-variable/manrope';
import '@fontsource-variable/dm-sans';
import { getImage, Picture } from 'astro:assets';
import manropeFont from '@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url';
import manropeExtendedFont from '@fontsource-variable/manrope/files/manrope-latin-ext-wght-normal.woff2?url';
import bodyFont from '@fontsource-variable/dm-sans/files/dm-sans-latin-wght-normal.woff2?url';
import portrait from '../assets/kristijan.jpg';
import portraitPreview from '../assets/kristijan-preview.webp?inline';
import Icon from '../components/Icon.astro';
import CvRequest from '../components/CvRequest.astro';
import Analytics from '../components/Analytics.astro';
import BrandMark from '../components/BrandMark.astro';
import Technologies from '../components/Technologies.astro';
import { site, expertise, impact } from '../data/site';
import '../styles/global.css';

const cvHref = '#contact';
const currentYear = new Date().getFullYear();
const portraitSizes = '(max-width: 600px) 82px, (max-width: 1000px) 40vw, 440px';
const portraitWidths = [160, 320, 480, 640, 900];
const portraitPreload = await getImage({ src: portrait, format: 'avif', width: 900, height: 1125, widths: portraitWidths });
const structuredData = { '@context': 'https://schema.org', '@type': 'ProfilePage', url: Astro.site?.href, name: site.name, mainEntity: { '@type': 'Person', name: site.name, url: Astro.site?.href, sameAs: site.profiles.map(profile => profile.url), jobTitle: site.role, description: site.description, knowsAbout: ['Software engineering', 'Engineering leadership', 'IT leadership', 'Software architecture', 'Platform engineering', 'Cloud computing', 'Software supply chain security', 'Secure software delivery', 'AI-assisted development'], homeLocation: { '@type': 'Country', name: 'Croatia' } } };
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={site.description} />
    <meta name="theme-color" content="#18171c" />
    <link rel="canonical" href={Astro.site} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" as="image" type="image/avif" href={portraitPreload.src} imagesrcset={portraitPreload.srcSet.attribute} imagesizes={portraitSizes} fetchpriority="high" />
    {[manropeFont, manropeExtendedFont, bodyFont].map(font => <link rel="preload" as="font" type="font/woff2" href={font} crossorigin="anonymous" />)}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${site.name} — ${site.role}`} />
    <meta property="og:description" content={site.description} />
    <meta property="og:url" content={Astro.site} />
    <meta property="og:image" content={new URL('/social-card.png', Astro.site)} />
    <meta property="og:image:alt" content={`Portrait of ${site.name}, ${site.role} — ${site.headline.join(' ')}`} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{site.name} — {site.role}</title>
    <script is:inline>
      (() => {
        document.documentElement.classList.add('js');
        let theme;
        try { theme = localStorage.getItem('theme'); } catch {}
        document.documentElement.dataset.theme = theme === 'light' || theme === 'dark'
          ? theme : (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="page-shell">
      <header class="site-header">
        <a class="wordmark" href="#" aria-label="Kristijan Lenković, home"><BrandMark class="brand-mark" /><span>Kristijan<br />Lenković<span class="wordmark-dot">.</span></span></a>
        <nav class="section-navigation" aria-label="Main navigation">
          <a class="nav-link" href="#impact">Experience</a>
          <a class="nav-link" href="#expertise">Approach</a>
          <a class="nav-link" href="#ai">AI</a>
          <a class="nav-link" href="#technologies" aria-label="Tech, Technologies"><span class="nav-label-full">Technologies</span><span class="nav-label-short" aria-hidden="true">Tech</span></a>
          <a class="nav-link" href="#contact">Contact</a>
        </nav>
        <div class="header-tools">
          <div class="header-profiles" role="group" aria-label="Professional profiles">{site.profiles.map(profile => <a href={profile.url} target="_blank" rel="noopener noreferrer" aria-label={`${site.name} on ${profile.label} (opens in a new tab)`} title={profile.label}><img src={profile.icon} alt="" width="22" height="22" /></a>)}</div>

          <span class="nav-divider" aria-hidden="true"></span>
          <button class="icon-button theme-toggle" type="button" aria-label="Switch to light theme" title="Switch theme" hidden><Icon name="sun" class="sun-icon" /><Icon name="moon" class="moon-icon" /></button>
        </div>
      </header>

      <main id="main">
        <section class="hero" aria-labelledby="hero-heading">
          <div class="hero-atmosphere" aria-hidden="true">
            <div class="hero-dot-field"></div>
            <svg class="hero-connections" viewBox="0 0 1400 800" preserveAspectRatio="xMidYMid slice" fill="none">
              <path class="connection-track" d="M480 800C480 520 920 620 920 290S1160 20 1400 80" />
              <path class="connection-track" d="M640 800C640 550 1100 650 1100 320S1310 100 1450 130" />
              <path class="connection-flow" d="M480 800C480 520 920 620 920 290S1160 20 1400 80" />
              <circle class="connection-node" cx="696" cy="602" r="5" />
              <circle class="connection-node connection-node-secondary" cx="920" cy="290" r="7" />
              <circle class="connection-node" cx="1210" cy="69" r="4" />
            </svg>
          </div>
          <div class="portrait-composition">
            <div class="portrait-visual">
              <div class="portrait-frame" style={`background-image: url("${portraitPreview}")`}>
                <Picture src={portrait} alt="Portrait of Kristijan Lenković" widths={portraitWidths} sizes={portraitSizes} formats={['avif', 'webp']} fallbackFormat="webp" loading="eager" fetchpriority="high" width={900} height={1125} />
              </div>
            </div>
            <p class="portrait-name">{site.name}<span class="theme-dot">.</span></p>
            <div class="location-tag"><Icon name="globe" /><span><span class="location-country">Based in Croatia</span><span class="tag-subline">A global perspective.</span></span></div>
          </div>
          <div class="hero-copy">
            <p class="eyebrow hero-eyebrow"><span class="status-dot"></span> ENGINEERING & IT LEADERSHIP</p>
            <h1 id="hero-heading">{site.headline[0].slice(0, -1)}<span class="theme-dot">.</span><br /><span class="impact-word">{site.headline[1].slice(0, -1)}<span class="theme-dot">.</span><svg aria-hidden="true" viewBox="0 0 530 16" preserveAspectRatio="none"><path d="M3 11C130 1 350 2 527 8" /></svg></span></h1>
            <p class="hero-description">{site.introduction}</p>
            <div class="proof-strip" aria-label="Experience at a glance">
              <div class="proof"><span class="proof-value"><span data-current-year data-year-offset={site.careerStartYear}>{currentYear - site.careerStartYear}</span><span class="accent">+</span></span><span>years delivering software</span></div>
              <div class="proof"><span class="proof-value">5 <span class="proof-arrow">→</span> 78</span><span>people in a department I grew</span></div>
              <div class="proof"><span class="proof-value proof-text">Founder</span><span>started and led a software company</span></div>
            </div>
            <div class="hero-actions">
              <a class="button button-primary" href={cvHref} data-cv-request>Request my CV <span class="button-arrow"><Icon name="diagonal" /></span></a>
              <a class="quiet-link" href="#impact">Selected experience <Icon name="down" /></a>
            </div>

          </div>

        </section>

        <section id="impact" class="impact section" aria-labelledby="impact-heading">
          <div class="section-marker"><span class="section-number">01 /</span><h2 id="impact-heading" class="eyebrow">SELECTED EXPERIENCE</h2></div>
          <div class="impact-grid">{impact.map(item => <article><h3>{item.title}<span class="theme-dot">.</span></h3><p>{item.result}</p></article>)}</div>
        </section>

        <section id="expertise" class="expertise section" aria-labelledby="expertise-heading">
          <div class="section-marker approach-marker"><span class="section-number">02 /</span><span class="eyebrow">LEADERSHIP IN PRACTICE</span></div>
          <div class="section-heading-row approach-heading"><h2 id="expertise-heading">My approach<span class="theme-dot">.</span></h2></div>
          <div class="expertise-grid">
            {expertise.map(item => <article id={item.id} class:list={['expertise-item', { 'ai-approach': item.id === 'ai' }]}><div class="expertise-top"><Icon name={item.icon} /><span>{item.number}</span></div><h3>{item.title.slice(0, -1)}<span class="theme-dot">.</span></h3><p>{item.text}</p><ul class="tags" aria-label={`${item.title} focus areas`}>{item.tags.map(tag => <li>{tag}</li>)}</ul></article>)}
          </div>

        </section>

        <Technologies />

        <section id="contact" class="contact section" aria-labelledby="contact-heading">
          <div class="contact-orbit" aria-hidden="true"></div>
          <div class="contact-content"><p class="eyebrow"><span class="status-dot"></span> ENGINEERING & TECHNOLOGY LEADERSHIP</p><h2 id="contact-heading">Let’s talk about<br />what’s next<span class="theme-dot">.</span></h2><div class="contact-bottom"><p class="opportunity-copy">{site.opportunities}</p><a class="button button-primary" href={cvHref} data-cv-request>Request my CV <span class="button-arrow"><Icon name="diagonal" /></span></a></div></div>
          <BrandMark class="contact-asterisk" />
        </section>
      </main>

      <nav class="profile-links" aria-label="Professional profiles">{site.profiles.map(profile => <a href={profile.url} target="_blank" rel="noopener noreferrer" aria-label={`${site.name} on ${profile.label} (opens in a new tab)`} title={profile.label}><img src={profile.icon} alt="" width="24" height="24" loading="lazy" /></a>)}</nav>
      <footer class="site-footer"><a href="#" class="footer-name">Kristijan Lenković<span class="accent">.</span></a><div class="footer-privacy"><a href="/privacy/">Privacy Policy</a><button type="button" data-analytics-settings hidden>Analytics preferences</button></div><a class="back-top" href="#">Back to top <Icon name="diagonal" /></a><p>© <span data-current-year>{currentYear}</span> Kristijan Lenković. All rights reserved.</p></footer>
    </div>
    <CvRequest />
    <Analytics />
    <script src="../scripts/site.ts"></script>
  </body>
</html>
