---
import '@fontsource-variable/dm-sans';
import '../styles/global.css';
import Analytics from '../components/Analytics.astro';
const analyticsConfigured = /^G-[A-Z0-9]+$/.test(import.meta.env.PUBLIC_GA_MEASUREMENT_ID || '');
---
<!doctype html>
<html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>Privacy Policy - Kristijan Lenković</title><meta name="description" content="How this website handles contact requests, optional analytics, and local preferences." /><link rel="canonical" href={new URL('/privacy/', Astro.site)} /><script is:inline>
  (() => { let theme; try { theme = localStorage.getItem('theme'); } catch {} document.documentElement.dataset.theme = theme === 'light' || theme === 'dark' ? theme : (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark'); })();
</script></head>
<body><main class="privacy-page"><a href="/">← Back to the website</a><h1>Privacy Policy</h1>
  <p>Kristijan Lenković is responsible for this website and the information you share through it.</p>
  <h2>Contact requests</h2>
  <p>Your contact details and message are used to respond to your enquiry. Service providers help deliver requests and protect the form from spam, and may process network identifiers and delivery records. Messages are retained in my mailbox and its backups until deleted.</p>
  {analyticsConfigured && <>
    <h2>Optional analytics</h2>
    <p>With your consent, Google Analytics uses cookies to measure visits and contact form activity. Your form answers are not included. You can decline or withdraw consent through “Analytics preferences.” Withdrawing consent stops future collection but does not delete data already collected. See the <a href="https://policies.google.com/privacy">Google privacy policy</a>.</p>
    <button type="button" class="privacy-preferences" data-analytics-settings hidden>Analytics preferences</button>
  </>}
  <h2>Browser preferences</h2>
  <p>Your theme preference is stored in your browser.{analyticsConfigured && ' Your analytics choice is remembered for up to 180 days.'} You can clear stored preferences using your browser settings.</p>
  <h2>Your information</h2>
  <p>Use the contact form to request access to, correction of, or deletion of your contact information.</p>
</main><Analytics /><script src="../scripts/analytics.ts"></script></body></html>
