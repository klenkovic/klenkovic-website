{
  "name": "kristijan-lenkovic-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "start": "astro dev --host 0.0.0.0",
    "check": "astro check",
    "build": "astro build",
    "preview": "astro preview --host 0.0.0.0",
    "test": "playwright test",
    "audit:performance": "node scripts/performance.mjs",
    "monitor:uptime": "node scripts/check-uptime.mjs",
    "test:uptime": "node --test tests/uptime.test.mjs",
    "test:contact": "node --test contact-worker/worker.test.mjs",
    "test:contact-flow": "node scripts/test-contact-flow.mjs",
    "contact:check": "wrangler deploy --dry-run --config contact-worker/wrangler.jsonc",
    "contact:dev": "wrangler dev --config contact-worker/wrangler.jsonc",
    "contact:deploy": "wrangler deploy --config contact-worker/wrangler.jsonc"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "astro": "7.4.4"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "^24.19.2",
    "chrome-launcher": "1.2.2",
    "lighthouse": "13.5.0",
    "sharp": "0.35.5",
    "typescript": "~5.9.3",
    "wrangler": "4.156.0"
  }
}
